{
  "name": "ospapas-admin-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "build": "node scripts/next.mjs build",
    "db:prepare": "node --env-file-if-exists=.env.poc node_modules/payload/bin.js run src/prepare-db.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --env-file-if-exists=.env.poc --test tests/access.integration.ts",
    "media:prepare": "node --env-file-if-exists=.env.poc scripts/prepare-storage.ts",
    "media:worker": "node --env-file-if-exists=.env.poc scripts/media-worker.ts",
    "test:media": "node --env-file-if-exists=.env.poc --test tests/media.integration.ts",
    "publication:prepare": "node --env-file-if-exists=.env.poc scripts/prepare-publication.ts",
    "publication:worker": "node --env-file-if-exists=.env.poc scripts/publication-worker.ts",
    "publication:demo": "node --env-file-if-exists=.env.poc scripts/publication-demo.ts",
    "test:publication": "node --env-file-if-exists=.env.poc --test tests/publication.integration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1176.0",
    "@payloadcms/db-postgres": "3.94.2",
    "@payloadcms/next": "3.94.2",
    "graphql": "16.15.0",
    "next": "16.4.6",
    "payload": "3.94.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
