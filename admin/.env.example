# Ambiente da aplicação. Aceita dev, hml ou prd. Este exemplo é exclusivo de DEV.
ADMIN_ENV=dev
DATABASE_URL=postgresql://fixture:senha-ficticia@127.0.0.1:5432/ospapas_poc_dev
PAYLOAD_SECRET=
POC_ADMIN_EMAIL=geral@example.invalid
POC_ADMIN_PASSWORD=

# Emuladores e namespaces locais. Defina credenciais fictícias distintas para mídia e backup.
POC_S3_ENDPOINT=http://127.0.0.1:5000
POC_S3_BUCKET=ospapas-poc-dev-privado
POC_S3_ACCESS_KEY=
POC_S3_SECRET_KEY=
POC_PUBLIC_ENV=dev
POC_PUBLIC_PREFIX=ospapas-poc
# POC_PUBLIC_ID_SECRET=

POC_PG_CONNECTION_MODE=direct
POC_RECOVERY_MAINTENANCE=0
POC_BACKUP_ENDPOINT=http://127.0.0.1:5000
POC_BACKUP_PREFIX=ospapas-backup-local
POC_BACKUP_ACCESS_KEY=
POC_BACKUP_SECRET_KEY=
POC_BACKUP_KEY=
POC_RECOVERY_DATABASE_URL=postgresql://restorer:senha-ficticia@127.0.0.1:5432/ospapas_poc_restauro
# POC_RECOVERY_INVALID_TEST_URL=postgresql://restorer:senha-ficticia@127.0.0.1:5432/ospapas_poc_invalido
# POC_RECOVERY_JOURNAL_TEST_URL=postgresql://restorer:senha-ficticia@127.0.0.1:5432/ospapas_poc_diario
# POC_RECOVERY_DB_TOOLS=/caminho/para/binarios-do-postgresql
# POC_FFMPEG=ffmpeg
# POC_FFPROBE=ffprobe
# POC_PUBLIC_PORT=3190
